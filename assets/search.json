---
layout: null
---
[{% for post in site.posts %}{% assign translation_key = post.path | split: '/' | last | remove: '.md' %}{% assign translation = site.data.post_translations[translation_key] %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"lang":{{ post.lang | default: 'en' | jsonify }},"date":{{ post.date | date: '%d.%m.%Y' | jsonify }},"categories":{{ post.categories | join: ', ' | jsonify }},"tags":{{ post.tags | join: ' ' | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | jsonify }},"text":{{ post.content | strip_html | normalize_whitespace | jsonify }},"translation":{% if translation %}{"title":{{ translation.title | jsonify }},"description":{{ translation.description | jsonify }},"lang":{{ translation.lang | jsonify }},"text":{{ translation.body | with_original_code: post.path | markdownify | strip_html | normalize_whitespace | jsonify }}}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
